# =============================================================================
# E2E suite configuration
# =============================================================================
# This suite is environment-agnostic. The single mandatory URL is
# FOSS_BASE_URL — everything else (per-app hosts, ForwardAuth host, cookie
# domain) is derived from it using the FOSS naming convention:
#
#   FOSS_BASE_URL=https://foss.<domain>
#       → main portal
#       → ForwardAuth = foss-auth.<domain>
#       → Outline     = foss-docs.<domain>
#       → Plane (PM)  = foss-pm.<domain>
#       → Penpot      = foss-design.<domain>
#       → SurfSense   = foss-research.<domain>
#       → cookie scope = .<domain>
# =============================================================================

# --- Required: SSO credentials ---
# Per sso-rules/admin.md this is "User A": the human's SSO identity,
# pre-promoted to admin across every app. Used by the worker fixture
# and as the admin baseline for the positive-side admin tests.
FOSS_USER=you@arbisoft.com
FOSS_PASS=your_password_here

# --- Optional: non-admin baseline SSO credentials ---
# "User B" per sso-rules/admin.md: a separate SSO identity that has
# NOT been promoted to admin on any app. Used by the non-admin side
# of the role-split tests in tests/apps/outline-admin.spec.ts and
# tests/apps/twenty-admin.spec.ts. Those blocks self-skip when unset.
# NORMAL_USER=normal-user@arbisoft.com
# NORMAL_PASS=your_password_here

# --- Optional: Plane god-mode admin credentials ---
# Required for tests/apps/pm-godmode.spec.ts admin sign-in test.
# Test self-skips if these are unset.
# PLANE_ADMIN_USER=admin@example.com
# PLANE_ADMIN_PASS=your_admin_password

# --- Optional: Twenty full-admin SSO override credentials ---
# The positive-side test in tests/apps/twenty-admin.spec.ts defaults to
# FOSS_USER/FOSS_PASS. Set this override only when Twenty full-admin rights
# (canAccessFullAdminPanel=true) belong to a different identity.
# TWENTY_ADMIN_USER=admin-user@arbisoft.com
# TWENTY_ADMIN_PASS=your_password_here

# Outline admin-side positive tests use FOSS_USER (User A, above) via
# the worker fixture. Twenty positive admin-panel test also uses FOSS_USER
# by default, with TWENTY_ADMIN_USER/TWENTY_ADMIN_PASS as an optional
# override when needed.

# --- Optional: target deployment ---
# Default: sandbox at foss.arbisoft.com.
# Switch to a different deployment (staging, prod, local) with this single line:
# FOSS_BASE_URL=https://foss.example.com

# --- Optional: browser selection ---
# Default (unset) → chromium only.
#   all                        → chromium + firefox + webkit
#   chromium | firefox | webkit
#   comma-separated list, e.g. firefox,webkit
# BROWSERS=all

# --- Optional: IDP overrides ---
# IDPs differ per deployment and aren't derivable from FOSS_BASE_URL.
# Defaults match the sandbox.
# FOSS_COGNITO_DOMAIN=amazoncognito.com
# FOSS_MPASS_DOMAIN=moneta-auth.sandbox.pressingly.net
# FOSS_IDP_HOSTS=amazoncognito.com,moneta-auth.sandbox.pressingly.net

# --- Optional: SSO cookie name override ---
# FOSS_AUTH_COOKIE=_oauth2_proxy

# --- Optional: bundle convention parameters (foss-server-bundle PR #46/#55) ---
# SMB_DEFAULT_WORKSPACE_NAME mirrors the env the bundle uses for the
# unified workspace name across all 5 apps (Plane slug, Outline
# subdomain, Penpot team, SurfSense search-space, Twenty subdomain).
# Default is `fossarbisoft` to match the live sandbox. Override when
# pointing the suite at a deployment with a different SMB workspace.
# SMB_DEFAULT_WORKSPACE_NAME=fossarbisoft

# Bot-Admin contract: the bundle's provisioning pre-seeds this user as
# workspace Admin in each app (default `system-bot@foss.arbisoft.com`).
# Tests that pin the "bot is Admin, FOSS_USER is Member" pattern read
# this value rather than hard-coding it.
# SYSTEM_BOT_EMAIL=system-bot@foss.arbisoft.com

# --- Optional: per-app workspace / team / space identifiers ---
# Defaults in `constants.ts` match the live sandbox's FOSS_USER role
# state (verified by API probe — see comments in constants.ts).
# Override only when pointing the suite at a deployment where FOSS_USER
# owns/admins different teams/spaces (e.g., after running
# foss-server-bundle/scripts/provision-admin/* to promote FOSS_USER into
# the SMB `fossarbisoft` scope — at which point the IDs below shift to
# the SMB team/space UUIDs).
# PENPOT_TEAM_ID=c16a7502-dcf5-8188-8007-f336e4292883
# OUTLINE_TEAM_ID=1a2e0bad-3c60-40a5-92b5-98b6b71c3316
# PLANE_WORKSPACE_ID=aab50fd3-d056-486e-9656-8ffb2f3e5996
# PLANE_ADMIN_WORKSPACE_SLUG=fossarbisoft   # falls back to SMB_DEFAULT_WORKSPACE_NAME when unset
# SURFSENSE_SEARCH_SPACE_ID=1

# FOSS_USER's workspace that NORMAL_USER must NOT be in. Used by
# `tests/apps/pm-workspace-isolation.spec.ts` to assert NORMAL_USER's
# UI / API access to this workspace is refused. Override only when
# the deployment uses a different "private to A, not B" slug.
# FOSS_USER_PRIVATE_WORKSPACE_SLUG=aa
